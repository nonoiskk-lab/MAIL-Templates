# ---------------------------------------------------------------------------
# MailCraft AI — environment variables
# Copy this file to .env.local and fill in real values. Never commit secrets.
# ---------------------------------------------------------------------------

# Public site URL (used for OAuth redirect URIs and metadata). Use your
# Vercel URL or custom domain in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (required) ----------------------------------------------------
# From your Supabase project settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used for account deletion.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI provider (required for generation) ----------------------------------
# One of: openai | anthropic | gemini
AI_PROVIDER=openai
AI_API_KEY=
# Optional model override. Defaults per provider:
#   openai -> gpt-4o-mini, anthropic -> claude-sonnet-5, gemini -> gemini-1.5-flash
AI_MODEL=

# --- Token encryption (required if you connect Gmail/Outlook) --------------
# Any long random string. Used to encrypt OAuth tokens at rest (AES-256-GCM).
TOKEN_ENCRYPTION_KEY=

# --- Google OAuth (optional — enables "Continue with Google" + Gmail send) -
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Microsoft OAuth (optional — enables Outlook send) ----------------------
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Usage limits (optional — sensible defaults are built in) --------------
FREE_DAILY_GENERATION_LIMIT=10
PRO_DAILY_GENERATION_LIMIT=200
BUSINESS_DAILY_GENERATION_LIMIT=1000
